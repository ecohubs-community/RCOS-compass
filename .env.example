# RCOS Compass — server configuration.
# Every variable here is parsed and validated at boot by src/lib/server/config.ts;
# the app refuses to start rather than start wrong. Values are omitted on purpose.
# See docs/00-architecture.md §10.

NODE_ENV=development
PUBLIC_APP_URL=http://localhost:5173

# What the server believes its own origin is. adapter-node reads this at startup;
# without it, form submissions are refused as cross-site. Same value as
# PUBLIC_APP_URL — required in production, and checked at boot.
ORIGIN=http://localhost:5173
DATABASE_URL=file:./data/compass.db

# Required. 32+ characters of random data: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Platform admins (docs/05-admin-console.md). Comma-separated, matched against a
# VERIFIED email at request time. Empty means the admin console does not exist.
ADMIN_EMAILS=

# AI. `null` disables it entirely and is what CI runs with; `fixture` replays
# recorded responses in tests. docs/00-architecture.md §4.
AI_PROVIDER=null
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_MONTHLY_TOKEN_BUDGET=2000000
AI_USER_MONTHLY_TOKENS=300000
AI_USER_DAILY_TASKS=25

# Mail. Invitations and digests carry a link, never content.
# smtps://user:pass@host:465 for a real server, smtp://localhost:1025 for a local
# catcher such as Mailpit. Left empty, every send refuses loudly rather than
# silently doing nothing — verification links are the only way into the app.
SMTP_URL=
MAIL_FROM="RCOS Compass <no-reply@example.org>"

# Uploads. docs/04-security.md §5.1.
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25
MAX_UNZIP_MB=200
MAX_EXTRACT_PAGES=300
EXTRACT_TIMEOUT_S=120
UPLOAD_PER_USER_HOUR=10
UPLOAD_PER_USER_DAY=40
UPLOAD_PER_COMMUNITY_DAY=60
STORAGE_MB=2048

# Per-IP ceiling for dynamic requests; assets and /healthz are exempt.
REQUESTS_PER_MINUTE=300

# Tighter ceiling for anything that checks a credential: sign-in, the two-factor
# challenge, enrolment. Per IP and, once signed in, per account.
AUTH_ATTEMPTS_PER_15MIN=10

LOG_LEVEL=info
BUILD_SHA=dev
