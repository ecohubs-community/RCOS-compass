# RCOS Compass — server configuration.
# Every variable here is parsed and validated at boot by src/lib/server/config.ts;
# the app refuses to start rather than start wrong. Values are omitted on purpose.
# See docs/00-architecture.md §10.

NODE_ENV=development
PUBLIC_APP_URL=http://localhost:5173
DATABASE_URL=file:./data/compass.db

# Required. 32+ characters of random data: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Platform admins (docs/05-admin-console.md). Comma-separated, matched against a
# VERIFIED email at request time. Empty means the admin console does not exist.
ADMIN_EMAILS=

# AI. `null` disables it entirely and is what CI runs with; `fixture` replays
# recorded responses in tests. docs/00-architecture.md §4.
AI_PROVIDER=null
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_MONTHLY_TOKEN_BUDGET=2000000
AI_USER_MONTHLY_TOKENS=300000
AI_USER_DAILY_TASKS=25

# Mail. Invitations and digests carry a link, never content.
SMTP_URL=
MAIL_FROM="RCOS Compass <no-reply@example.org>"

# Uploads. docs/04-security.md §5.1.
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25
MAX_UNZIP_MB=200
MAX_EXTRACT_PAGES=300
EXTRACT_TIMEOUT_S=120
UPLOAD_PER_USER_HOUR=10
UPLOAD_PER_USER_DAY=40
UPLOAD_PER_COMMUNITY_DAY=60
STORAGE_MB=2048

LOG_LEVEL=info
BUILD_SHA=dev
