{
	"name": "rcos-compass",
	"version": "0.3.1",
	"private": true,
	"license": "PolyForm-Noncommercial-1.0.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "node --env-file-if-exists=.env build/index.js",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"check": "pnpm i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "pnpm i18n:compile && node scripts/check-standard.mjs && prettier --check . && eslint . && node scripts/check-tokens.mjs && node scripts/check-i18n.mjs",
		"format": "prettier --write .",
		"test": "pnpm i18n:compile && vitest run",
		"test:unit": "vitest run --project unit",
		"test:integration": "vitest run --project integration",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
		"snapshot": "node --env-file-if-exists=.env --import tsx scripts/snapshot.mjs",
		"restore": "node --env-file-if-exists=.env --import tsx scripts/restore.mjs",
		"search:rebuild": "node --env-file-if-exists=.env --import tsx scripts/rebuild-search.ts",
		"db:studio": "drizzle-kit studio",
		"check:tokens": "node scripts/check-tokens.mjs",
		"test:gallery": "playwright test --config playwright.gallery.config.ts",
		"check:standard": "node scripts/check-standard.mjs",
		"check:i18n": "node scripts/check-i18n.mjs",
		"fixtures:documents": "node scripts/make-document-fixtures.mjs",
		"test:e2e:ai": "playwright test --config playwright.ai.config.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@eslint/js": "10.0.1",
		"@iconify-json/tabler": "^1.2.38",
		"@inlang/paraglide-js": "^2.25.0",
		"@playwright/test": "1.62.1",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/better-sqlite3": "9.6.0",
		"@types/js-yaml": "4.0.9",
		"@types/node": "26.4.1",
		"@types/nodemailer": "^8.0.1",
		"drizzle-kit": "0.31.10",
		"eslint": "10.9.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.12.0",
		"pino-pretty": "13.1.3",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.0",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"tsx": "^4.23.13",
		"typescript": "6.0.3",
		"typescript-eslint": "8.69.0",
		"unplugin-icons": "^23.0.1",
		"vite": "8.2.2",
		"vitest": "4.1.11"
	},
	"dependencies": {
		"better-auth": "1.7.2",
		"better-sqlite3": "13.0.3",
		"bits-ui": "2.19.0",
		"drizzle-orm": "0.45.2",
		"fflate": "^0.8.3",
		"js-yaml": "4.3.2",
		"mammoth": "^1.12.2",
		"marked": "^18.0.11",
		"nodemailer": "^9.1.1",
		"pdfjs-dist": "6.3.289",
		"pino": "10.3.1",
		"tailwind-merge": "3.6.0",
		"unpdf": "^1.8.1",
		"uuid": "14.0.2",
		"valibot": "1.4.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"better-sqlite3",
			"esbuild"
		],
		"overrides": {
			"esbuild": ">=0.25.12",
			"cookie": ">=0.7.2 <1"
		}
	}
}
